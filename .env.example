# ──────────────────────────────────────────────────────────────
# arXiv Digest Agent — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
#
# GROQ_API_KEY is OPTIONAL — the agent runs in zero-config mode
# without it (extractive briefing + extractive QA).
# Set it for full LLM-powered output.

# Groq API Key (free tier: https://console.groq.com)
# Used for: LLM-powered summarization, paper ranking, and QA
GROQ_API_KEY=

# Model Selection
# Available on Groq: qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b
GROQ_MODEL=qwen/qwen3.8-27b

# Embeddings are fully local (BAAI/bge-small-en-v1.5) — no API key needed.
# First run downloads ~130MB from HuggingFace, then works fully offline.
#
# (Optional) Hugging Face Token to silence unauthenticated rate limit warnings:
# Get free token from: https://huggingface.co/settings/tokens
HF_TOKEN=
