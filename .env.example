# ──────────────────────────────────────────────────────────────
# arXiv Digest Agent — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# Both keys are required for full functionality.

# Groq API Key (free tier: https://console.groq.com)
# Used for: LLM-powered summarization, paper ranking, and QA
GROQ_API_KEY=

# Jina AI API Key (free tier: https://jina.ai/embeddings)
# Used for: generating semantic embeddings of paper chunks
JINA_API_KEY=

# Model Selection
# Recommended Groq models: qwen/qwen3.8-27b, llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=qwen/qwen3.8-27b
